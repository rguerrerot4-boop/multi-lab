{
  "expo": {
    "name": "Multi LAB",
    "slug": "multi-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ec.unemi.multilab"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ec.unemi.multilab",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/logo-mark.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Multi LAB usa tu ubicación para mostrarte los consultorios cercanos y organizar tus visitas."
        }
      ]
    ],
    "scheme": "multilab",
    "splash": {
      "image": "./assets/logo-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
